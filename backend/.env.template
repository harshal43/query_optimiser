# Snowflake
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=sqs_service_account
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE
SNOWFLAKE_SCHEMA=ACCOUNT_USAGE

# LLM — same endpoint for all models, per-model API keys
API_URL=https://your-llm-gateway/v1/chat/completions
ANTHROPIC_API_KEY=your-anthropic-key   # used for claude-* models
OPENAI_API_KEY=your-openai-key         # used for gpt-* models
GOOGLE_API_KEY=your-google-key         # used for gemini-* models

# Model names configured in Admin Panel (llm_primary / llm_fallback / llm_cost_model)
# Defaults: claude-sonnet-4 / gpt-4o / gemini-2.5-flash
# Available: claude-sonnet-4, gpt-4, gpt-4o, gemini-2.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sqs_db

# Application
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO
